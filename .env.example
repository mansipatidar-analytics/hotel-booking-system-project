# ==========================================
# HOTELPRO ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port & Execution Mode
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
# Provide your MongoDB Atlas or local MongoDB connection URI
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/hotelpro?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/hotelpro

# JWT Authentication Secrets
JWT_SECRET=hotelpro_super_secure_academic_secret_key_2026_replace_in_production
JWT_EXPIRES_IN=7d

# Email SMTP (Nodemailer - Optional for email dispatch)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
EMAIL_FROM="HotelPro Concierge <reservations@hotelpro.io>"

# Payment Gateways (Optional: Test sandbox credentials)
# When omitted, HotelPro operates in Sandbox Demo Mode with instant folio settlement
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret

STRIPE_SECRET_KEY=sk_test_placeholder_secret_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# Cloudinary (Optional: Image storage upload handling)
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_api_key
CLOUDINARY_API_SECRET=placeholder_api_secret
